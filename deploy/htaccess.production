# Deploy target: https://selmar.ksisolusi.com  (docroot: ~/public_html/selmar)
# Berkas ini menggantikan .htaccess pada docroot subdomain.

# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/ksis7654/apps/selmar"
PassengerBaseURI "/"
PassengerPython "/home/ksis7654/virtualenv/apps/selmar/3.10/bin/python"
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION BEGIN
<IfModule Litespeed>
SetEnv ALLOWED_HOSTS "selmar.ksisolusi.com,www.selmar.ksisolusi.com,localhost,127.0.0.1"
SetEnv DEBUG "False"
SetEnv SECRET_KEY "Cgm-jPx5zaVk_TSBC1WiAZ1sUxXrpXypfpE7H1YiIWfRLowa89_O1tYHIufqmo1-"
SetEnv DB_NAME "ksis7654_selmar"
SetEnv DB_USER "ksis7654_bono"
SetEnv DB_PASSWORD "Tr1-B0n0"
SetEnv DB_HOST "localhost"
SetEnv DB_PORT "3306"
# OpenBLAS/numpy: paksa 1 thread per worker (48 thread/worker membanjiri host)
SetEnv OMP_NUM_THREADS "1"
SetEnv OPENBLAS_NUM_THREADS "1"
SetEnv MKL_NUM_THREADS "1"
SetEnv NUMEXPR_NUM_THREADS "1"
</IfModule>
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION END

<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# File media diunggah aplikasi disajikan langsung oleh LiteSpeed.
<FilesMatch "\.(?i:pdf|docx?|xlsx?|png|jpe?g|gif|webp|svg|ico|mp4|zip)$">
Header set Content-Disposition "inline"
</FilesMatch>
